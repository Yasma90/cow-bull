## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
*.log

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# MonoDevelop
*.pidb

# VS Code
.vscode/

# Build directories
build/
out/

# NuGet packages
*.nupkg
*.snupkg
packages/
# The packages folder can be ignored because of Package Restore
**/packages/*

# Visual Studio cache files
.vs/
*_i.c
*_p.c
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.log
*.vspscc
*_i.obj
*_p.obj

# Others
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.DotCover
*.nvuser
TestResults/
*.ncrunch*
*.localhistory/
*.idea/

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Rider
.idea/
*.sln.iml

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# dotCover
*.dotCover

# Other files
*.dbmdl
*.bak
*.backup
*.mdf
*.ldf
*.ndf

# Publish Web Output
*publish/
*.Publish.xml

# Entity Framework
Migrations/

# Azure Web App publish settings
.PublishSettings

# Windows image file caches
*.stackdump

# Others
# Uncomment if using TFS
# $tf/

# JetBrains Rider
.idea/
*.sln.iml