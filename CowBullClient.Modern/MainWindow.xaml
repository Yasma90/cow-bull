<Window x:Class="CowBullClient.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CowBull Client (Modern)" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" Text="CowBull Client - Modern Architecture" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <!-- Connection Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Connection: " FontWeight="Bold"/>
            <TextBlock Text="{Binding ConnectionStatus}" Margin="5,0"/>
        </StackPanel>
        
        <!-- Connection Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Connect" Command="{Binding ConnectCommand}" 
                    Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" 
                    Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="New Game" Command="{Binding NewGameCommand}" 
                    Width="80" Height="30"/>
        </StackPanel>
        
        <!-- Game Controls -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Your Guess:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding CurrentGuess, UpdateSourceTrigger=PropertyChanged}" 
                     MaxLength="4" FontSize="14" Height="25" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="Send Guess" Command="{Binding SendGuessCommand}" 
                    Width="90" Height="25" Margin="10,0,0,0"/>
            <TextBlock Grid.Column="3" Text="{Binding AttemptsRemaining, StringFormat='Attempts: {0}'}" 
                       VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold"/>
        </Grid>
        
        <!-- Game History -->
        <GroupBox Grid.Row="4" Header="Game History" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding GameMessage}" 
                           FontWeight="Bold" Margin="5" 
                           TextWrapping="Wrap"/>
                
                <ListBox Grid.Row="1" ItemsSource="{Binding GameAttempts}" 
                         DisplayMemberPath="Result"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Margin="5"/>
            </Grid>
        </GroupBox>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Ready"/>
                    <Run Text=" | Connected: "/>
                    <Run Text="{Binding IsConnected}"/>
                    <Run Text=" | Game Active: "/>
                    <Run Text="{Binding GameInProgress}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>