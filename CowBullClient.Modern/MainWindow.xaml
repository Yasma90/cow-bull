<Window x:Class="CowBullClient.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CowBull Client"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock DockPanel.Dock="Left"
                       Text="CowBull"
                       FontSize="26"
                       FontWeight="SemiBold"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding ConnectionStatus}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Connect" Command="{Binding ConnectCommand}"
                    MinWidth="92" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                    MinWidth="92" Padding="12,6" Margin="0,0,8,0"
                    ToolTip="Abandons the game and does not reveal the secret. Use Surrender to see it."/>
            <Button Content="New game" Command="{Binding NewGameCommand}"
                    MinWidth="92" Padding="12,6"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding CurrentGuess, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="{Binding NumberLength}"
                     FontFamily="Consolas"
                     FontSize="20"
                     Padding="8,5"
                     ToolTip="ASCII digits, no duplicates. Press Enter to submit.">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SubmitGuessCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Submit guess"
                    Command="{Binding SubmitGuessCommand}"
                    Padding="14,6" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Surrender"
                    Command="{Binding SurrenderCommand}"
                    Padding="14,6" Margin="8,0,0,0"/>
        </Grid>

        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,8"
                       Text="Bulls: digit in the correct position. Cows: digit present, wrong position."
                       TextWrapping="Wrap"
                       Foreground="#FF5C6570"/>
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       Text="{Binding RevealedSecret, StringFormat='Secret: {0}'}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RevealedSecret}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ListView ItemsSource="{Binding Attempts}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="45" DisplayMemberBinding="{Binding AttemptNumber}"/>
                        <GridViewColumn Header="Guess" Width="130" DisplayMemberBinding="{Binding Guess}"/>
                        <GridViewColumn Header="Bulls" Width="110" DisplayMemberBinding="{Binding Bulls}"/>
                        <GridViewColumn Header="Cows" Width="110" DisplayMemberBinding="{Binding Cows}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding AttemptsRemaining, StringFormat='Attempts remaining: {0}'}"
                       FontWeight="SemiBold" Margin="20,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
