<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        x:Class="CowBullClient.View.MainWindow"
        Title="Vaca Toro" ShowInTaskbar="True" xmlns:view="clr-namespace:CowBullClient.View"
    Icon="../Resources/ic_launcher.png" Height="460" Width="275">

    <Window.Resources>
        <ResourceDictionary Source="..\Resources\Style\Style.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="292*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255*"/>
        </Grid.ColumnDefinitions>
        <Image Source="../Resources/fondo.png" Stretch="Fill" Grid.ColumnSpan="3" Grid.RowSpan="2"/>
        <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch">
            <ListView Background="Transparent" ItemsSource="{Binding ListShow}">
                <!--<view:Resultado Loaded="Resultado_Loaded"/>-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <view:Resultado/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
        <!--<view:MainControl Grid.Row="0"/>-->
        <TextBox x:Name="txtNumber" HorizontalAlignment="Left" Height="26" Margin="6,2,0,0" TextWrapping="Wrap" Text="{Binding TBoxSendNumber}" VerticalAlignment="Top" Width="50" MaxLength="4"/> <!--IsEnabled="{Binding EnableButton}"-->
        <Button Content="Send" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Width="41" Margin="57,3,0,0" Command="{Binding BtnSendCommand}" Height="25" IsEnabled="{Binding ElementName=txtNumber, Path=Text.Length}" Name="btnSend" RenderTransformOrigin="0.266,0.528"/>
        <Label Content="{Binding TimeSound.TimerInput,Mode=OneWay}" IsEnabled="{Binding IsEnableTime}" FontSize="16" FontFamily="Comic" Foreground="Black" HorizontalAlignment="Left" Margin="188,3,0,0" VerticalAlignment="Top" Height="25" Width="72" Background="Transparent"/>
        <Button Name="buttonStartDict" ToolTip="Refresh" Content="Connect" Command="{Binding ConnectCmd}" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Width="55" Margin="97,3,0,0">
            <!--<Button.Content>
                <Image Source="../Resources/ic_action_refresh.png" Stretch="Fill" SnapsToDevicePixels="True"/>
            </Button.Content>-->
            <!--<Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>-->
        </Button>
        <Button Width="30" Margin="154,3,0,8" Background="Transparent" SnapsToDevicePixels="True" HorizontalAlignment="Left">
            <Button.Content>
                <Image Source="../Resources/ic_action_volume_on.png"  SnapsToDevicePixels="True"/>
            </Button.Content>
        </Button>
    </Grid>
</Window>
