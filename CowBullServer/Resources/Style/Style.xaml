<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <RadialGradientBrush x:Key="WindowGradient" GradientOrigin="0.331,0.256" SpreadMethod="Repeat">
        <RadialGradientBrush.RelativeTransform>
            <TransformGroup>
                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="0.479" ScaleY="0.463"/>
                <SkewTransform AngleX="0" AngleY="0" CenterX="0.5" CenterY="0.5"/>
                <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/>
                <TranslateTransform X="0.408" Y="0.367"/>
            </TransformGroup>
        </RadialGradientBrush.RelativeTransform>
        <GradientStop Color="#9B646464" Offset="0.98"/>
        <GradientStop Color="#FF484848" Offset="0.006"/>
        <GradientStop Color="#7E4D4D4D" Offset="0.434"/>
    </RadialGradientBrush>
    
    <Style x:Key="menuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="Red" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Comic Sans MS" />
    </Style>

    <Style x:Key="textStyle" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Comic Sans MS" />
    </Style>

</ResourceDictionary>