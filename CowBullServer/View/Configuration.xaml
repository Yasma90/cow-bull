<Window x:Class="CowBullServer.View.Configuration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="131" Width="159"
            WindowStartupLocation="CenterOwner"
            WindowStyle="None"
            AllowsTransparency="True"
            ShowInTaskbar="False"
            Background="#00000000">
    <!-- main border -->
    <Border x:Name="MainBorder"
          BorderThickness="0"
          CornerRadius="12,12,12,12" Margin="0,0,0,-10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.126,-0.197"
                           EndPoint="0.874,1.197">
                <GradientStop Offset="0"
                      Color="#FF615E5A" />
                <GradientStop Offset="1"
                      Color="#FF535353" />
                <GradientStop Offset="0.284"
                      Color="#FFE0E0E0" />
                <GradientStop Offset="0.365"
                      Color="#FFFFFFFF" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="IP:" Width="40" Height="25" HorizontalAlignment="Left" Margin="0,2"/>
            <TextBox Text="" Width="80" Height="25" Grid.Column="1" />
            <Label Content="Port:" Height="25" Margin="0,4,30,0" Grid.Row="1"/>
            <TextBox Text="" Width="Auto" Height="25"  Grid.Column="1" Grid.Row="1"/>
            <Label Content="Number:" Height="25" Grid.Row="2" Margin="0,2,10,2"/>
            <TextBox Text="" Width="Auto" Height="25"  MaxLength="4" Grid.Column="1" Grid.Row="2"/>
            <Button Content="Acept" Command="{Binding TT}" Height="25"  Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" Margin="0,19,0,-18" Click="Button_Click"/>
        </Grid>
    </Border>
</Window>
