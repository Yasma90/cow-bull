<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        x:Class="CowBullServer.View.MainWindow"
        Title="Toro Vaca Server" xmlns:view="clr-namespace:CowBullServer.View"
        Icon="../Resources/ic_launcher.png" Height="460" Width="275" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen" BorderBrush="SaddleBrown" BorderThickness="1">

    <Window.Resources>
        <ResourceDictionary Source="..\Resources\Style\Style.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="340*"/>
            <RowDefinition Height="22*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <Image Source="../Resources/fondo_main.png" Stretch="Fill" Grid.ColumnSpan="2" Grid.RowSpan="4"/>

        <!-- lays a shadow over the UI if the about dialog is being displayed-->
        <Border  x:Name="Shadow"
             Grid.ColumnSpan="2"
             Grid.RowSpan="4"
             Background="Black"
             Opacity="0.36"
             Visibility="Collapsed"/>

        <!--<view:ListJugada Grid.Row="1"/>-->
        <!--<ContentControl Grid.Row="1" Content="{Binding VistaActual}"/>-->
        <Menu Grid.Row="0" VerticalAlignment="Center"  HorizontalAlignment="Right" Background="Transparent" Grid.Column="1" Margin="0,4,0,5">

            <MenuItem  Name="Restart" Command="{Binding Restart}" Width="24">
                <MenuItem.Icon>
                    <Image Source="../Resources/[001027].png"  Width="18"
                         Height="18"
                         ToolTip="Restart"
                         Cursor="Hand"
                         Opacity="0.8"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="Sound" Command="{Binding SetSound}" Width="24">
                <MenuItem.Icon>
                    <Image Source="../Resources/ic_action_volume_on.png"></Image>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Name="Settings" Click="Click_Config" Width="23">
                <MenuItem.Icon>
                    <Image Source="../Resources/abs__menupnt.png"></Image>
                </MenuItem.Icon>

                <MenuItem Header="Rendirse">
                    <MenuItem.Icon>
                        <Image Source="../Resources/ic_action_bad_black.png"></Image>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Capturar Pantalla">
                    <MenuItem.Icon>
                        <Image Source="../Resources/[000135].png"></Image>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Compartir Pantalla">
                    <MenuItem.Icon>
                        <Image Source="../Resources/abs__ic_menu_share_holo_light.png"></Image>
                    </MenuItem.Icon>
                </MenuItem>


                <MenuItem Header="Setting">
                    <MenuItem.Icon>
                        <Image Source="../Resources/abs__menupnt.png"></Image>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ayuda">
                    <MenuItem.Icon>
                        <Image Source="../Resources/ic_action_help.png"></Image>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Acerca de">
                    <MenuItem.Icon>
                        <Image Source="../Resources/[000118].png"></Image>
                    </MenuItem.Icon>
                </MenuItem>

            </MenuItem>

        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="Transparent" Grid.ColumnSpan="2">
            <TextBox Height="26" TextWrapping="Wrap" Text="{Binding TBoxSendNumber}" Width="50" MaxLength="4"  x:Name="tboxNUmber" Margin="0,4"/>
            <Button Content="Send" x:Name="btnSend" Command="{Binding BtnSendCommand}" IsEnabled="{Binding EnableButton, Mode=TwoWay}" Height="25" Width="41" Background="Transparent" Margin="0,4" />
            <Button ToolTip="Refresh" Content="Message" Command="{Binding SendMessage}"  Height="25" Background="Transparent" Width="52" Margin="0,4">
                <!--<Button.Content>
                <Image Source="../Resources/ic_action_refresh.png" Stretch="Fill" SnapsToDevicePixels="True"/>
            </Button.Content>-->
                <!--<Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>-->
            </Button>
            <Button Content="Lisent" Command="{Binding ListenServer}" Height="25" Width="37" Background="Transparent" Margin="0,4">
                <!--<Button.Content>
                   <Image Source="../Resources/ic_action_volume_on.png"  SnapsToDevicePixels="True"/>
                </Button.Content>-->
            </Button>
            <Label Content="{Binding TimeSound.TimerInput, Mode=OneWay}" IsEnabled="{Binding IsEnableTime}" Height="25" Width="72" Background="Transparent"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">
            <ListView Background="Transparent" ItemsSource="{Binding ListShow}">
                <!--<view:Resultado Loaded="Resultado_Loaded"/>-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <view:Resultado/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
        <Label Grid.Row="0" Content="{Binding Path=Connected,Mode=TwoWay}"  HorizontalAlignment="Left" Margin="10,6,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.184,-2.2" Height="27" Width="95"/>

        <StatusBar 
               Background="Black"
               Grid.Row="3"
               Grid.ColumnSpan="2"
               Opacity="0.5" Grid.RowSpan="2">
            <TextBlock Foreground="White" FontStyle="Italic">
            Latest item change event: from item
            <TextBlock x:Name="txtOldItem" />
            to item
            <TextBlock x:Name="txtNewItem" />
            </TextBlock>
        </StatusBar>

    </Grid>
</Window>
