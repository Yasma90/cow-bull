<UserControl x:Class="CowBullServer.View.Resultado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid> 
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label FontSize="18" FontFamily="Comic" Foreground="Black" Content="{Binding Numero}" HorizontalAlignment="Center" VerticalAlignment="Center" Name="numberPlay" Grid.Column="0"/>
        <Image HorizontalAlignment="Stretch" Width="47" VerticalAlignment="Center" Name="imageToro" Source="../Resources/toro_viejo.png" Grid.Column="1"/>
        <Label FontSize="18" FontFamily="Comic" Foreground="Black" Content="{Binding Toros}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
        <Image HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="47" Name="imageVaca" Source="../Resources/vaca_vieja.png" Grid.Column="3"/>
        <Label FontSize="18" FontFamily="Comic" Foreground="Black" Content="{Binding Vacas}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="4"/>
    </Grid>
</UserControl>
