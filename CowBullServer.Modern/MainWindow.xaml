<Window x:Class="CowBullServer.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CowBull Server"
        Width="760"
        Height="540"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock DockPanel.Dock="Left"
                       Text="CowBull authoritative server"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding ServerStatus}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Start server"
                    Command="{Binding StartCommand}"
                    MinWidth="110"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Content="Stop server"
                    Command="{Binding StopCommand}"
                    MinWidth="110"
                    Padding="12,6"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Activity">
            <ListBox ItemsSource="{Binding Activity}"
                     FontFamily="Consolas"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding Endpoint, StringFormat='Endpoint: {0}'}"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding ConnectedClients, StringFormat='Connected clients: {0}'}"
                       FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
