    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AssemblyName>CowBullServer.Modern</AssemblyName>
    <RootNamespace>CowBullServer.Modern</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CowBull.Application\CowBull.Application.csproj" />
    <ProjectReference Include="..\CowBull.Domain\CowBull.Domain.csproj" />
    <ProjectReference Include="..\CowBull.Infrastructure\CowBull.Infrastructure.csproj" />
  </ItemGroup>
</Project>
