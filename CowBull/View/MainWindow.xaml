<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        x:Class="CowBull.View.MainWindow"
        Title="Vaca Toro" ShowInTaskbar="True" xmlns:view="clr-namespace:CowBull.View"
    Icon="../Resources/ic_launcher.png" Height="460" Width="275">

    <Window.Resources>
        <ResourceDictionary Source="../Resources/Styles/Style.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="292*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255*"/>
        </Grid.ColumnDefinitions>
        <Image Source="../Resources/fondo.png" Stretch="Fill" Grid.ColumnSpan="3" Grid.RowSpan="2"/>
        <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch">
            <ListView Background="Transparent" ItemsSource="{Binding ListShow}">
                <!--<view:Resultado Loaded="Resultado_Loaded"/>-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <view:Resultado/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
        <!--<view:MainControl Grid.Row="0"/>-->
        <TextBox HorizontalAlignment="Left" Height="26" Margin="11,2,0,0" TextWrapping="Wrap" Text="{Binding TBoxSendNumber}" VerticalAlignment="Top" Width="50" MaxLength="4"  Name="tboxNUmber"/>
        <Button Content="Send" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Width="41" Margin="69,3,0,0" Command="{Binding BtnSendCommand}" Height="25" IsEnabled="{Binding EnableButton}" Name="btnSend" RenderTransformOrigin="0.266,0.528"/>
        <Label Content="{Binding TimeSound.TimerInput,Mode=OneWay}" IsEnabled="{Binding IsEnableTime}" FontSize="16" FontFamily="Comic" Foreground="Black" HorizontalAlignment="Left" Margin="188,3,0,0" VerticalAlignment="Top" Height="25" Width="72" Background="Transparent"/>
        <Button Name="buttonStartDict" ToolTip="Refresh" Command="{Binding }" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Width="25" Margin="115,3,0,0">
            <Button.Content>
                <Image Source="../Resources/ic_action_refresh.png" Stretch="Fill" SnapsToDevicePixels="True"/>
            </Button.Content>
            <!--<Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>-->
        </Button>
        <Button Height="25" Width="30" Margin="148,3,89,8" Background="Transparent" SnapsToDevicePixels="True" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button.Content>
                <Image Source="../Resources/ic_action_volume_on.png"  SnapsToDevicePixels="True"/>
            </Button.Content>
        </Button>
    </Grid>
</Window>
